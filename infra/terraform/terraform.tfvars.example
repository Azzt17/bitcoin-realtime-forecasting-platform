# Copy this file to terraform.tfvars and fill in local values.
# Never commit terraform.tfvars.

do_token = "dop_v1_xxx"

trusted_ssh_cidr = "YOUR_PUBLIC_IP/32"

ssh_public_key_path = "~/.ssh/bitcoin_realtime_platform.pub"

region = "sgp1"

